WA_BIND_HOST=127.0.0.1
WA_PORT=8082
WHATSAPP_VERIFY_TOKEN=replace-with-meta-verify-token
WHATSAPP_APP_SECRET=replace-with-meta-app-secret
# Comma-separated E.164 phone numbers allowed to talk to the agent
WHATSAPP_ALLOWLIST=+491700000001
# Optional: point to guarded-agent-template (leave empty for standalone demo mode)
AGENT_SERVICE_URL=http://host.docker.internal:8081
# Real voice notes: speech-to-text (OpenAI-compatible; default Groq whisper-large-v3-turbo). Without a key the demo uses simulated transcripts.
GROQ_API_KEY=
STT_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3-turbo
# Replies back to WhatsApp (Cloud API). Without both, the webhook processes messages but does not answer.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Spoken replies: voice note in -> voice note out (Groq Orpheus TTS, English or Saudi Arabic voice picked from the reply text).
# The text reply is always sent first. Accept the model terms in the Groq console once.
VOICE_REPLIES=0
TTS_MODEL=canopylabs/orpheus-v1-english
TTS_VOICE=troy
TTS_MODEL_AR=canopylabs/orpheus-arabic-saudi
TTS_VOICE_AR=fahad
